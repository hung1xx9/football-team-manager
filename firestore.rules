rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Primary team data: Publicly readable, writable by any authenticated user
    match /teams/primary {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // 2. All subcollections of primary: Publicly readable, writable by any authenticated user
    match /teams/primary/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // 3. User-specific data (Legacy/Migrated)
    match /teams/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || userId == 'primary');

      match /{allPaths=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || userId == 'primary');
      }
    }
    
    // 4. Fallback for any other 'teams' access (Authenticated)
    match /teams/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
